{
  "name": "dutta-tour-travel",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "cd client && npm install && npm run build",
    "start": "npm run start --workspace=server",
    "seed": "npm run seed --workspace=server",
    "install:all": "npm install"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.2",
    "@rollup/rollup-linux-x64-musl": "4.63.2"
  }
}
